{
  "name": "@wanlianyida/wop-typescript-sdk",
  "version": "0.1.3",
  "description": "WOP 商户侧官方 TypeScript SDK：协议核心（签名/摘要/L2 数字信封/验签解密）+ 可插拔 HTTP 适配层",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wop-platform/wop-typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/wop-platform/wop-typescript-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./axios": {
      "import": {
        "types": "./dist/axios.d.ts",
        "default": "./dist/axios.js"
      },
      "require": {
        "types": "./dist/axios.d.cts",
        "default": "./dist/axios.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "axios": [
        "dist/axios.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "node tests/fetch-pinned.mjs && publint && attw --pack . && api-extractor run && api-extractor run -c api-extractor.axios.json && node tests/smoke.cjs && node tests/smoke.mjs",
    "api:snapshot": "api-extractor run --local && api-extractor run --local -c api-extractor.axios.json",
    "coverage": "vitest run --coverage",
    "typecheck": "node tests/fetch-pinned.mjs && tsc --noEmit",
    "test:bdd": "node tests/fetch-pinned.mjs && node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js tests/features --import \"tests/features/steps/**/*.ts\" --format summary",
    "test:mutation": "node tests/fetch-pinned.mjs && node tests/mutation/run-mutations.mjs",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run"
  },
  "keywords": [
    "wop",
    "gateway",
    "rsa",
    "digital-envelope",
    "aes-gcm",
    "webcrypto"
  ],
  "peerDependencies": {
    "axios": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@cucumber/cucumber": "^13.2.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "axios": "^1.13.2",
    "publint": "^0.3.24",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "tinypool": ">=2.1.2",
      "fast-uri": ">=3.1.8",
      "source-map-js": ">=1.2.2",
      "brace-expansion@>=2.0.0 <2.1.7": ">=2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-hp3w-g68c-fv3c"
      ]
    }
  }
}
